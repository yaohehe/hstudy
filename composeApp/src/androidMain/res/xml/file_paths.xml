<?xml version="1.0" encoding="utf-8"?>
<paths>
    <!-- 分享文本文件（备份/家庭同步）：cacheDir/shared/ -->
    <cache-path name="shared" path="shared/" />
    <!-- 拍照输出：getExternalFilesDir(Pictures)/（错题/证明照片凭证，不会被缓存清理） -->
    <external-files-path name="pictures" path="Pictures/" />
    <!-- 兼容旧实现：cacheDir/photos/ -->
    <cache-path name="photos" path="photos/" />
    <!-- 应用私有文件目录 -->
    <files-path name="files" path="." />
    <!-- 兼容原 external-files-path 备份路径 -->
    <external-files-path name="backup" path="." />
</paths>