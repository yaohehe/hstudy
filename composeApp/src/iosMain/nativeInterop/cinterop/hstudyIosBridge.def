package = com.hstudy.app.iosbridge
language = Objective-C
headers = Foundation/Foundation.h
---
#import <Foundation/Foundation.h>
#import <CommonCrypto/CommonKeyDerivation.h>
#import <CommonCrypto/CommonRandom.h>

NS_ASSUME_NONNULL_BEGIN

// 只索引 Foundation：Xcode 26.5 模拟器 SDK 的 UIKit 伞头文件里
// UIKitDefines.h 引用了 <UIUtilities/UIDefines.h>，该头文件在公共 SDK 中不存在，
// cinterop 索引器会直接失败；UserNotifications/UIKit 的类型因此都不出现在本模块签名里，
// 参数统一用 NSObject*，Kotlin 侧的 UNMutableNotificationContent / UIViewController
// 都是它的子类，可直接传入。
//
// iOS 26 SDK 把 UNMutableNotificationContent 的 title/body/sound 重新声明为 readwrite，
// 但 Kotlin 侧沿用了父类 UNNotificationContent 的只读声明；NSObject 的 KVC 也没暴露给
// Kotlin。赋值改在这里用 ObjC 侧 KVC 完成，通知文案与提示音不会被静默丢弃。
static inline void HStudyFillNotificationContent(
    NSObject *content,
    NSString *_Nullable title,
    NSString *_Nullable body,
    NSObject *_Nullable sound
) {
    if (title != nil) { [content setValue:title forKey:@"title"]; }
    if (body != nil) { [content setValue:body forKey:@"body"]; }
    if (sound != nil) { [content setValue:sound forKey:@"sound"]; }
}

// UIActivityViewController 在 iPad 上没有 popover 锚点会直接抛异常，需要以 pageSheet 呈现。
// UIModalPresentationStyle 的常量无法从 Kotlin 侧稳定引用（且 UIKit 头文件不可索引），
// 这里按 UIKit 头文件中的原始枚举值赋值：UIModalPresentationPageSheet = 1。
static inline void HStudyUsePageSheetPresentation(NSObject *viewController) {
    [viewController setValue:@(1) forKey:@"modalPresentationStyle"];
}

// 家长密码：cinterop 只消费头文件，因此实现保留为 static inline，由生成的绑定桩携带；
// PBKDF2 与安全随机盐都在 CommonCrypto 侧完成。编码格式固定为
// pbkdf2-sha256$600000$<base64 salt>$<base64 hash>。
static const NSUInteger kHStudyPasswordSaltLength = 16;
static const NSUInteger kHStudyPasswordKeyLength = 32;
static const uint32_t kHStudyPasswordIterations = 600000;

static inline BOOL HStudyDeriveParentPasswordKey(
    NSData *password,
    NSData *salt,
    uint8_t derivedKey[32]
) {
    if (password == nil || salt.length != kHStudyPasswordSaltLength) {
        return NO;
    }

    static const uint8_t emptyByte = 0;
    const uint8_t *passwordBytes = password.length > 0 ? password.bytes : &emptyByte;
    return CCKeyDerivationPBKDF(
        kCCPBKDF2,
        (const char *)passwordBytes,
        password.length,
        salt.bytes,
        salt.length,
        kCCPRFHmacAlgSHA256,
        kHStudyPasswordIterations,
        derivedKey,
        kHStudyPasswordKeyLength
    ) == kCCSuccess;
}

static inline BOOL HStudyConstantTimeEqual(const uint8_t left[32], const uint8_t right[32]) {
    volatile uint8_t difference = 0;
    for (NSUInteger index = 0; index < kHStudyPasswordKeyLength; index++) {
        difference |= left[index] ^ right[index];
    }
    return difference == 0;
}

static inline NSString * _Nullable HStudyHashParentPassword(NSString *password) {
    NSData *passwordData = [password dataUsingEncoding:NSUTF8StringEncoding];
    if (passwordData == nil) {
        return nil;
    }

    uint8_t salt[16];
    if (CCRandomGenerateBytes(salt, sizeof(salt)) != kCCSuccess) {
        return nil;
    }

    uint8_t derivedKey[32];
    if (!HStudyDeriveParentPasswordKey(
        passwordData,
        [NSData dataWithBytes:salt length:sizeof(salt)],
        derivedKey
    )) {
        return nil;
    }

    NSString *saltBase64 = [[NSData dataWithBytes:salt length:sizeof(salt)] base64EncodedStringWithOptions:0];
    NSString *keyBase64 = [[NSData dataWithBytes:derivedKey length:sizeof(derivedKey)] base64EncodedStringWithOptions:0];
    return [NSString stringWithFormat:@"pbkdf2-sha256$%u$%@$%@", kHStudyPasswordIterations, saltBase64, keyBase64];
}

static inline NSData * _Nullable HStudyDecodeCanonicalBase64(NSString *value) {
    NSData *decoded = [[NSData alloc] initWithBase64EncodedString:value options:0];
    if (decoded == nil || ![[decoded base64EncodedStringWithOptions:0] isEqualToString:value]) {
        return nil;
    }
    return decoded;
}

static inline int HStudyVerifyParentPassword(NSString *password, NSString *encoded) {
    NSArray<NSString *> *parts = [encoded componentsSeparatedByString:@"$"];
    if (parts.count != 4 ||
        ![parts[0] isEqualToString:@"pbkdf2-sha256"] ||
        ![parts[1] isEqualToString:@"600000"]) {
        return 0;
    }

    NSData *salt = HStudyDecodeCanonicalBase64(parts[2]);
    NSData *expectedKey = HStudyDecodeCanonicalBase64(parts[3]);
    if (salt.length != kHStudyPasswordSaltLength || expectedKey.length != kHStudyPasswordKeyLength) {
        return 0;
    }

    NSData *passwordData = [password dataUsingEncoding:NSUTF8StringEncoding];
    uint8_t actualKey[32];
    if (!HStudyDeriveParentPasswordKey(passwordData, salt, actualKey)) {
        return 0;
    }

    return HStudyConstantTimeEqual(actualKey, expectedKey.bytes) ? 1 : 0;
}

NS_ASSUME_NONNULL_END
